# ---- App ----
# Public base URL, used for payment callbacks and invite links.
APP_URL=http://localhost:3000

# ---- Database (Supabase Postgres) ----
# Pooled connection for the app (Supabase "Transaction pooler", port 6543, add ?pgbouncer=true)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hearay
# Direct connection for migrations (Supabase "Session pooler"/direct, port 5432)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hearay

# ---- Business rules ----
# Flat service fee per order in whole FCFA (0 = no fee). Open question in the spec.
SERVICE_FEE_XAF=0
# Allowed smartcard lengths, comma separated.
SMARTCARD_LENGTHS=10
# Minutes before an unpaid order expires.
ORDER_EXPIRY_MINUTES=10

# ---- Payments ----
# fake | notchpay
PAYMENT_PROVIDER=fake
# FakeProvider: ms before a payment succeeds (phones ending in 0 fail).
FAKE_PROVIDER_DELAY_MS=10000
# FakeProvider webhook signing secret (for testing the webhook endpoint with curl).
FAKE_WEBHOOK_SECRET=change-me
# Notch Pay keys (dashboard -> Settings -> API keys). Use sandbox keys first.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_SECRET=
NOTCHPAY_API_URL=https://api.notchpay.co

# ---- SMS ----
# console (logs to stdout). Add a real provider once chosen (open question).
SMS_PROVIDER=console

# ---- Admin auth ----
# supabase | dev   ("dev" = local password login, refused when NODE_ENV=production)
AUTH_MODE=dev
# dev mode only: password shared by every admin user, and cookie signing secret.
DEV_ADMIN_PASSWORD=hearay-dev
SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, used to invite staff. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Seeding the first owner (npm run db:seed) ----
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Owner
# supabase mode only: password for the owner's Supabase Auth account
SEED_OWNER_PASSWORD=

# ---- Cron ----
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reconcile.
CRON_SECRET=change-me

# ---- Testing only ----
# Allows FakeProvider, AUTH_MODE=dev and the test clock in a production build
# (`next start`), for e2e tests. NEVER set this on a real deployment.
UNSAFE_TEST_MODE=0
# Lets the X-Test-Now header move the server clock (used by the expiry e2e test).
ALLOW_TEST_CLOCK=0
