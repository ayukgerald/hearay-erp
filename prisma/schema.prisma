// Hearay database schema. Money is whole FCFA (XAF has no cents) stored as Int.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentMethod {
  mtn_momo
  orange_money

  @@map("payment_method")
}

enum OrderStatus {
  awaiting_payment
  paid
  renewed
  payment_failed
  expired
  refunded

  @@map("order_status")
}

enum PaymentStatus {
  initiated
  pending
  succeeded
  failed
  expired

  @@map("payment_status")
}

enum AdminRole {
  owner
  staff

  @@map("admin_role")
}

model Package {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  monthlyPriceXaf Int      @map("monthly_price_xaf")
  isActive        Boolean  @default(false) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  badge           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders          Order[]

  @@map("packages")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  reference       String        @unique
  smartcardNumber String        @map("smartcard_number")
  packageId       String        @map("package_id") @db.Uuid
  packageName     String        @map("package_name")
  monthlyPriceXaf Int           @map("monthly_price_xaf")
  months          Int
  serviceFeeXaf   Int           @map("service_fee_xaf")
  totalXaf        Int           @map("total_xaf")
  customerPhone   String        @map("customer_phone")
  paymentMethod   PaymentMethod @map("payment_method")
  status          OrderStatus   @default(awaiting_payment)
  renewedById     String?       @map("renewed_by") @db.Uuid
  renewedAt       DateTime?     @map("renewed_at") @db.Timestamptz(3)
  adminNote       String?       @map("admin_note")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  package     Package       @relation(fields: [packageId], references: [id])
  renewedBy   AdminUser?    @relation(fields: [renewedById], references: [id])
  payments    Payment[]
  events      OrderEvent[]
  smsMessages SmsMessage[]

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([smartcardNumber])
  @@map("orders")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String
  providerReference String        @unique @map("provider_reference")
  amountXaf         Int           @map("amount_xaf")
  phone             String
  method            PaymentMethod
  status            PaymentStatus @default(initiated)
  failureReason     String?       @map("failure_reason")
  rawResponse       Json          @default("{}") @map("raw_response")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String    @unique @map("event_id")
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("webhook_events")
}

model OrderEvent {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actor      String
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_events")
}

model SmsMessage {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  toPhone           String   @map("to_phone")
  kind              String
  body              String
  status            String   @default("queued")
  providerReference String?  @map("provider_reference")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("sms_messages")
}

model AdminUser {
  id            String    @id @db.Uuid // same id as the Supabase Auth user
  name          String
  email         String    @unique
  role          AdminRole @default(staff)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  renewedOrders Order[]

  @@map("admin_users")
}
